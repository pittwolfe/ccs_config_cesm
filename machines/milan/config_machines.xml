<machine MACH="milan">
    <DESC>
      Machine file for SeaWulf's Milan nodes using Intel's oneAPI 2024, its builtin MPI library,
      and pnetcdf.
    </DESC>
    <OS>LINUX</OS>
    <COMPILERS>intel-oneapi</COMPILERS>
    <MPILIBS>impi</MPILIBS>
    <PROJECT>carbon</PROJECT>
    <CIME_OUTPUT_ROOT>$ENV{HOME}/scratch/cesm/</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>$ENV{HOME}/project/cesm/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>$ENV{HOME}/cesm/inputdata/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$ENV{HOME}/scratch/cesm/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>$ENV{HOME}/project/cesm/cesm_baselines</BASELINE_ROOT>
    <CCSM_CPRNC>$ENV{HOME}/project/carbon/intel-oneAPI-2024-milan/bin/cprnc</CCSM_CPRNC>
    <GMAKE>make</GMAKE>
    <GMAKE_J>8</GMAKE_J>
    <BATCH_SYSTEM>slurm</BATCH_SYSTEM>
    <SUPPORTED_BY>christopher.wolfe@stonybrook.edu</SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>96</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>96</MAX_MPITASKS_PER_NODE>
    <PROJECT_REQUIRED>FALSE</PROJECT_REQUIRED>
    <mpirun mpilib="impi">
      <executable>mpirun</executable>
      <arguments>
        <arg name="ntasks"> -np {{ total_tasks }} </arg>
      </arguments>
    </mpirun>
    <module_system type="module" allow_error="true">
      <init_path lang="perl">/usr/share/Modules/init/perl.pm</init_path>
      <init_path lang="python">/usr/share/Modules/init/python.py</init_path>
      <init_path lang="csh">/usr/share/Modules/init/csh</init_path>
      <init_path lang="sh">/usr/share/Modules/init/sh</init_path>
      <cmd_path lang="perl">/usr/bin/modulecmd perl</cmd_path>
      <cmd_path lang="python">/usr/bin/modulecmd python</cmd_path>
      <cmd_path lang="sh">module</cmd_path>
      <cmd_path lang="csh">module</cmd_path>
      <modules>
        <command name="purge"/>
        <command name="load">slurm</command>
        <command name="load">shared</command>
      </modules>
      <modules compiler="intel-oneapi">
        <command name="load">intel/oneAPI/2024.2</command>
        <command name="load">tbb/latest</command>
        <command name="load">compiler-rt/latest</command>
        <command name="load">compiler/latest</command>
        <command name="load">mkl/latest</command>
        <command name="load">mpi/latest</command>
        <command name="load">gcc/13.2.0</command>
        <command name="load">hdf5_18</command>
        <command name="load">curl/8.14.1</command>        
      </modules>
    </module_system>
    <environment_variables>
      <env name="OMP_STACKSIZE">256M</env>
      <env name="LD_LIBRARY_PATH">$ENV{HOME}/project/carbon/intel-oneAPI-2024-milan/lib:$ENV{LD_LIBRARY_PATH}</env>
      <env name="HDF5_PLUGIN_PATH">$ENV{HOME}/project/carbon/intel-oneAPI-2024-milan/hdf5/lib/plugin</env>
    </environment_variables>
    <resource_limits>
      <resource name="RLIMIT_STACK">-1</resource>
    </resource_limits>
</machine>
